# Copy to .env and fill in. .env is gitignored — never commit the real key.
# Your team key is handed out at kickoff.
REVEL8_API_KEY=

# Base URL is shared at kickoff; this is the published default.
REVEL8_API_BASE=https://target-api.apps.01.cf.eu01.stackit.cloud/v1

# --- Research / OSINT pipeline (all optional; the open-tier MVP needs none) ---
# See research/ASSESSMENT.md for what each unlocks and the cheapest adequate option.

# Higher GitHub rate limit (60 -> 5000 req/hr). Optional.
GITHUB_TOKEN=

# Scraping API for the blocked tier (LinkedIn/Instagram/X) + JS-rendered pages,
# and optionally SERP for URL discovery. Bright Data CLI is already installed here.
BRIGHTDATA_API_KEY=

# Web-search API for URL discovery (alternative to Bright Data SERP). Optional.
# Brave has a free tier; SerpAPI is an alternative.
BRAVE_SEARCH_API_KEY=
SERP_API_KEY=
